# 1. Cargamos la librería necesaria para el resumen rápido
library(dplyr)
# 2. Preparamos el gráfico en un solo paso
gwas %>%
group_by(OBS_CT) %>%
mutate(media_SE = mean(SE, na.rm = TRUE)) %>%
ggplot(aes(x = factor(OBS_CT), y = SE)) +
# Dibujamos los violines con los datos originales
geom_violin() +
# Dibujamos la línea usando la columna de medias que acabamos de crear
geom_line(aes(y = media_SE, group = 1), colour = 'gray') +
# Dibujamos los puntos rojos
geom_point(aes(y = media_SE), colour = 'red', size = 2) +
labs(x = "Tamaño de muestra (N)", y = "Error estándar (SE)") +
theme_minimal()
