gene %>% summarise(across(everything(), n_distinct))
mrna %>% summarise(across(everything(), n_distinct))
exon %>% summarise(across(everything(), n_distinct))
cds %>% summarise(across(everything(), n_distinct))
region %>% summarise(across(everything(), n_distinct))
gene   <- gene[, -c(2, 5, 7)]
mrna   <- mrna[, -c(2, 5, 7)]
exon   <- exon[, -c(2, 5, 7)]
cds   <- cds[, -c(2, 5)]
region   <- region[, -c(2, 5, 6, 7)]
gene$longitud <- gene$end - gene$start + 1
resumen_gene <- data.frame(
tipo       = 'GENE',
número     = nrow(gene),
long.Media = mean(gene$longitud),
long.SD    = sd(gene$longitud)
)
mrna$longitud <- mrna$end - mrna$start + 1
resumen_mrna <- data.frame(
tipo       = 'mRNA',
número     = nrow(mrna),
long.Media = mean(mrna$longitud),
long.SD    = sd(mrna$longitud)
)
exon$longitud <- exon$end - exon$start + 1
resumen_exon <- data.frame(
tipo       = 'EXON',
número     = nrow(exon),
long.Media = mean(exon$longitud),
long.SD    = sd(exon$longitud)
)
region$longitud <- region$end - region$start + 1
resumen_region <- data.frame(
tipo       = 'REGION',
número     = nrow(region),
long.Media = mean(region$longitud),
long.SD    = sd(region$longitud)
)
cds$longitud <- cds$end - cds$start + 1
resumen_cds <- data.frame(
tipo       = 'CDS',
número     = nrow(cds),
long.Media = mean(cds$longitud),
long.SD    = sd(cds$longitud)
)
resumen <- bind_rows(resumen_cds, resumen_exon, resumen_gene, resumen_mrna, resumen_region)
# Esto es una lista de marcos de datos:
